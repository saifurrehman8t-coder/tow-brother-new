{
  "cleanUrls": false,
  "trailingSlash": false,

  "redirects": [
    {
      "source": "/",
      "has": [{ "type": "host", "value": "www.towbrother.com" }],
      "destination": "https://towbrother.com/",
      "permanent": true
    },
    {
      "source": "/(.*)",
      "has": [{ "type": "host", "value": "www.towbrother.com" }],
      "destination": "https://towbrother.com/$1",
      "permanent": true
    },
    {
      "source": "/car-towing-lahore/",
      "destination": "/car-towing-lahore.html",
      "permanent": true
    },
    {
      "source": "/car-recovery-lahore/",
      "destination": "/car-recovery-lahore.html",
      "permanent": true
    },
    {
      "source": "/tow-truck-lahore/",
      "destination": "/tow-truck-lahore.html",
      "permanent": true
    },
    {
      "source": "/lahore-areas/",
      "destination": "/lahore-areas.html",
      "permanent": true
    }
  ],

  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "SAMEORIGIN"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "X-DNS-Prefetch-Control",
          "value": "on"
        }
      ]
    },
    {
      "source": "/(.*)\\.(html)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=3600, must-revalidate"
        }
      ]
    },
    {
      "source": "/(.*)\\.(css|js|woff|woff2|ttf|otf)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/(.*)\\.(jpg|jpeg|png|gif|webp|svg|ico)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=86400"
        }
      ]
    },
    {
      "source": "/sitemap.xml",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=86400"
        },
        {
          "key": "Content-Type",
          "value": "application/xml"
        }
      ]
    }
  ]
}
